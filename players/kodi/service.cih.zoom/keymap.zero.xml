<?xml version="1.0" encoding="UTF-8"?>
<!--
  Binds the 0 key of the remote to the CIH Auto-Zoom override (spec R11): each press moves the playing title along
  automatic -> off -> 1.33 -> 1.78 -> 1.85 -> 2.00 -> 2.35 -> 2.39 -> automatic, kept for that title.
  Install: copy to userdata/keymaps/ on the Shield, then reload keymaps (or restart Kodi).
  Only the playback windows are bound, so the 0 key still works in the PIN pad and in text boxes.
-->
<keymap>
  <FullscreenVideo>
    <keyboard>
      <zero>RunScript(service.cih.zoom)</zero>
    </keyboard>
  </FullscreenVideo>
  <VideoOSD>
    <keyboard>
      <zero>RunScript(service.cih.zoom)</zero>
    </keyboard>
  </VideoOSD>
  <SeekBar>
    <keyboard>
      <zero>RunScript(service.cih.zoom)</zero>
    </keyboard>
  </SeekBar>
</keymap>