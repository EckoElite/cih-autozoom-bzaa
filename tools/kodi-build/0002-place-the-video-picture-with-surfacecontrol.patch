+  // CIH: the view stays at full size and its picture is placed with a SurfaceControl transaction (API 29+) made on
+  // the calling (render) thread. The layout change below goes through the UI thread, which handles requests once
+  // per display frame: requests made within one frame merge into one, so about a third of the steps of a zoom ramp
+  // were lost (measured on a Shield: 135 requested, 89 applied), and each one arrived a frame or more late.
+  // Any failure falls back to the layout change for the rest of this view's life.
+  private final Object mGeometryLock = new Object();
+  private SurfaceControl.Transaction mTransaction = null;
+  private boolean mUseLayout = false;
+  private int mFullWidth = 0;
+  private int mFullHeight = 0;
+  private Rect mLastRect = null;
+  private long mGeometryCount = 0;
+
+  private boolean applyGeometry(int left, int top, int right, int bottom)
+  {
+    if (mUseLayout || Build.VERSION.SDK_INT < 29)
+      return false;
+    try
+    {
+      synchronized (mGeometryLock)
+      {
+        if (!mIsCreated || mFullWidth <= 0 || mFullHeight <= 0)
+          return false;
+        SurfaceControl sc = getSurfaceControl();
+        if (sc == null || !sc.isValid())
+          return false;
+        if (mTransaction == null)
+          mTransaction = new SurfaceControl.Transaction();
+        Rect dest = new Rect(left, top, right, bottom);
+        mTransaction.setGeometry(sc, new Rect(0, 0, mFullWidth, mFullHeight), dest, Surface.ROTATION_0);
+        mTransaction.apply();
+        mLastRect = dest;
+        if (mGeometryCount++ == 0)
+          Log.d(TAG, "XBMCVideoView: placing the picture with SurfaceControl, view " + mFullWidth + "x" + mFullHeight);
+        return true;
+      }
+    }
+    catch (Throwable e)
+    {
+      Log.w(TAG, "XBMCVideoView: SurfaceControl placement failed, using layout changes: " + e);
+      return false;
+    }
+  }
