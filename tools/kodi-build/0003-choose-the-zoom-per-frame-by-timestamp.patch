+// CIH: a per-frame zoom table written by the zoom add-on (special://temp/cih_zoom.txt) and looked up by the
+// picture's own timestamp, so a zoom change lands on exactly its frame whatever the timing of the commands.
+//   CIH1 <serial>
+//   <seconds> <zoom>      one line per change, ascending; the zoom holds from that time on
+// Times are the player's (0 is the first frame), as the analyzer's are. The renderer leaves the marker file below
+// when a playback starts, so the add-on knows the table will be read.
+const std::string CIH_TABLE_FILE = "special://temp/cih_zoom.txt";
+const std::string CIH_MARKER_FILE = "special://temp/cih_renderer.txt";
+
+class CCihZoomTable
+{
+public:
+  // The zoom the table gives for a picture at `seconds`, or false when there is no table (or none yet applies).
+  bool Lookup(double seconds, float& zoom)
+  {
+    Refresh();
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_entries.empty())
+      return false;
+    // the last entry at or before this time (half a millisecond of tolerance for rounding in the file)
+    auto it = std::upper_bound(m_entries.begin(), m_entries.end(), seconds + 0.0005,
+                               [](double t, const Entry& e) { return t < e.t; });
+    if (it == m_entries.begin())
+      return false;
+    zoom = (it - 1)->zoom;
+    return true;
+  }
+
+  // A new playback: forget what was loaded (the file is read again when it is there).
+  void Forget()
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_entries.clear();
+    m_serial.clear();
+    m_lastCheck = std::chrono::steady_clock::time_point();
+  }
+
+  // The playback is over: nothing may carry over to the next title.
+  void Remove()
+  {
+    Forget();
+    XFILE::CFile::Delete(CIH_TABLE_FILE);
+  }
+
+private:
+  struct Entry
+  {
+    double t;
+    float zoom;
+  };
+
+  void Refresh()
+  {
+    const auto now = std::chrono::steady_clock::now();
+    {
+      std::lock_guard<std::mutex> lock(m_mutex);
+      if (now - m_lastCheck < std::chrono::milliseconds(200))
+        return;
+      m_lastCheck = now;
+    }
+
+    std::string text;
+    {
+      XFILE::CFile file;
+      if (!file.Open(CIH_TABLE_FILE))
+      {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        m_entries.clear();
+        m_serial.clear();
+        return;
+      }
+      char buf[8192];
+      ssize_t n;
+      while ((n = file.Read(buf, sizeof(buf))) > 0)
+        text.append(buf, static_cast<size_t>(n));
+    }
+
+    const size_t eol = text.find('\n');
+    if (eol == std::string::npos || text.compare(0, 5, "CIH1 ") != 0)
+      return;
+    const std::string serial = text.substr(5, eol - 5);
+    {
+      std::lock_guard<std::mutex> lock(m_mutex);
+      if (serial == m_serial)
+        return;
+    }
+
+    std::vector<Entry> entries;
+    const char* p = text.c_str() + eol + 1;
+    while (*p != '\0')
+    {
+      char* end = nullptr;
+      const double t = std::strtod(p, &end);
+      if (end == p)
+        break;
+      p = end;
+      const double z = std::strtod(p, &end);
+      if (end == p)
+        break;
+      p = end;
+      entries.push_back({t, static_cast<float>(z)});
+      while (*p == '\n' || *p == '\r' || *p == ' ')
+        ++p;
+    }
+
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_entries = std::move(entries);
+    m_serial = serial;
+    CLog::Log(LOGINFO, "CIH zoom table loaded: {} entries, serial {}", m_entries.size(), m_serial);
+  }
+
+  std::mutex m_mutex;
+  std::vector<Entry> m_entries;
+  std::string m_serial;
+  std::chrono::steady_clock::time_point m_lastCheck;
+};
+
+CCihZoomTable g_cihZoomTable;
+} // namespace
 
